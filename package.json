{
  "name": "whatsapp-birthday-bot",
  "version": "1.0.0",
  "description": "Self-hosted bot that sends personalised birthday messages on WhatsApp at midnight, in each friend's own timezone. Web dashboard, CSV data, Docker.",
  "main": "src/index.js",
  "bin": {
    "birthday-bot": "src/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js --no-whatsapp",
    "preview": "node src/cli.js preview",
    "check": "node src/cli.js check",
    "test": "node --test"
  },
  "keywords": [
    "whatsapp",
    "birthday",
    "bot",
    "automation",
    "self-hosted",
    "whatsapp-web.js",
    "docker"
  ],
  "author": "japneet250",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/gabarito": "^5.3.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japneet250/whatsapp-birthday-bot.git"
  },
  "homepage": "https://github.com/japneet250/whatsapp-birthday-bot#readme",
  "bugs": {
    "url": "https://github.com/japneet250/whatsapp-birthday-bot/issues"
  }
}
