# Copy this file to .env and fill it in.

# Password for the web dashboard (any username works). If empty, one is generated and printed in the logs.
DASHBOARD_PASSWORD=change-me

# Your timezone, as an IANA name. People in birthdays.csv can override it with their own.
TIMEZONE=America/Toronto

# When messages go out, 24h HH:MM, in each person's own timezone.
SEND_TIME=00:00

# Random pause between messages when several people share a birthday (seconds).
MIN_DELAY_SEC=8
MAX_DELAY_SEC=30

# PORT=3000

# Dashboard only, never sends. Handy for trying it out.
# WHATSAPP=off
